# Local-first: launch from repository root; keys remain on backend only.
EQUITYLENS_DATABASE_URL=sqlite:///./data/equitylens.db
EQUITYLENS_DATA_DIR=./data
EQUITYLENS_DEMO=false
EQUITYLENS_BACKGROUND_REFRESH=true
EQUITYLENS_REFRESH_SECONDS=3600
# Scheduled screening also resumes the last manual run when that run has auto_refresh=true.
# This flag additionally starts a screen before any manual run exists.
EQUITYLENS_SCREENER_AUTO_REFRESH=false
EQUITYLENS_SCREENER_REFRESH_SECONDS=21600
EQUITYLENS_SCREENER_MAX_DEEP_ANALYSIS=15
EQUITYLENS_SCREENER_REQUEST_DELAY=0.5
EQUITYLENS_HISTORY_CACHE_SECONDS=1800
EQUITYLENS_FUNDAMENTALS_CACHE_SECONDS=21600
EQUITYLENS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional local API protection. Supply Authorization: Bearer <token> to clients.
# EQUITYLENS_API_TOKEN=
# Optional AI summaries: only saved-report creation calls the configured model.
# Never put these keys in VITE_ variables or browser storage.
# EQUITYLENS_LLM_API_KEY=
# EQUITYLENS_LLM_MODEL=gpt-4.1-mini
# EQUITYLENS_LLM_BASE_URL=https://api.openai.com/v1
# Compose database password: change for any deployment beyond a private local machine.
POSTGRES_PASSWORD=equitylens-local-development
